{
  "name": "capacitor-starter",
  "private": true,
  "version": "2.5.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node --max-old-space-size=8192 node_modules/vite/bin/vite.js build",
    "build:tsc": "pnpm run typecheck && npm run build",
    "typecheck": "node node_modules/typescript-native/lib/tsc.js -p tsconfig.app.json",
    "typecheck:legacy": "node --max-old-space-size=6144 node_modules/typescript/bin/tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "clear-cache": "rm -rf .vite node_modules/.vite node_modules/.cache dist .tsbuildinfo tsconfig.tsbuildinfo && pnpm store prune",
    "fresh-start": "pnpm clear-cache && pnpm install && pnpm dev",
    "build:web:seven_cs": "vite build --mode seven_cs",
    "build:web:ssdc": "vite build --mode ssdc",
    "build:web:stemx": "vite build --mode stemx",
    "android:assemble:seven_cs:debug": "cd android && ./gradlew assembleSeven_csDebug",
    "android:assemble:seven_cs:release": "cd android && ./gradlew assembleSeven_csRelease",
    "android:assemble:ssdc:debug": "cd android && ./gradlew assembleSsdcDebug",
    "android:assemble:ssdc:release": "cd android && ./gradlew assembleSsdcRelease",
    "android:assemble:stemx:debug": "cd android && ./gradlew assembleStemxDebug",
    "android:assemble:stemx:release": "cd android && ./gradlew assembleStemxRelease",
    "electron:build:seven_cs:win": "electron-builder -c electron/electron-builder.seven_cs.json -w",
    "electron:build:seven_cs:mac": "electron-builder -c electron/electron-builder.seven_cs.json -m",
    "electron:build:ssdc:win": "electron-builder -c electron/electron-builder.ssdc.json -w",
    "electron:build:ssdc:mac": "electron-builder -c electron/electron-builder.ssdc.json -m",
    "electron:build:zoe:store:win": "bash electron/build-windows-zoe.sh"
  },
