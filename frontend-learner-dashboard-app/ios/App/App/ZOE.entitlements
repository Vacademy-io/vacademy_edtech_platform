<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!--
	  ZOE's own domain, and ONLY its own. App/App.entitlements is shared by all
	  15 targets and lists eight other brands' hosts (ssdc, 7cs, learner.vacademy,
	  ithinkers, fivesep, shiksha-nation, enarkuplift, soullifee) while omitting
	  ZOE's — so ZOE shipped claiming Shiksha Nation's applinks domain and none of
	  its own. Universal links additionally need student.zoeedtech.com to serve an
	  apple-app-site-association listing 7XKD5M7288.io.zoeedtech.app; that file is
	  public/.well-known/apple-app-site-association and ships with the WEB deploy,
	  not with this .ipa.
	-->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:student.zoeedtech.com</string>
	</array>
</dict>
</plist>
