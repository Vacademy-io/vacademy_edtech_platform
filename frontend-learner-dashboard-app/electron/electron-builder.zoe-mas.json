{
  "appId": "io.zoeedtech.app",
  "productName": "ZOE Online School",
  "directories": {
    "buildResources": "resources-zoe",
    "output": "dist-mas-zoe"
  },
  "files": [
    "assets/**/*",
    "build/**/*",
    "app/**/*",
    "capacitor.config.*",
    "electron-flavor.json",
    "package.json",
    {
      "from": "node_modules",
      "filter": [
        "**/*",
        "!electron/dist/**/*",
        "!electron/**/*",
        "!electron-builder/**/*",
        "!app-builder-lib/**/*",
        "!electron-osx-sign/**/*",
        "!electron-rebuild/**/*",
        "!**/*.md",
        "!**/*.map",
        "!**/test/**",
        "!**/tests/**",
        "!**/.bin/**",
        "!app-builder-bin/**/*",
        "!7zip-bin/**/*",
        "!lzma-native/**/*",
        "!iconv-corefoundation/**/*",
        "!node-notifier/vendor/notifu/**/*",
        "!node-notifier/vendor/snoreToast/**/*"
      ]
    }
  ],
  "asar": true,
  "asarUnpack": [
    "**/*.node"
  ],
  "compression": "normal",
  "nodeGypRebuild": false,
  "buildDependenciesFromSource": false,
  "npmRebuild": false,
  "mas": {
    "category": "public.app-category.education",
    "icon": "assets/zoe.icns",
    "target": [
      {
        "target": "pkg",
        "arch": [
          "arm64"
        ]
      }
    ],
    "type": "distribution",
    "entitlements": "entitlements.zoe.mas.plist",
    "entitlementsInherit": "entitlements.mas.inherit.plist",
    "provisioningProfile": "embedded-zoe.provisionprofile",
    "hardenedRuntime": false,
    "identity": "Saurabh Kumar (7XKD5M7288)",
    "minimumSystemVersion": "12.0",
    "entitlementsLoginHelper": "entitlements.mas.loginhelper.plist"
  },
  "extraMetadata": {
    "version": "1.0.1",
    "electronFlavorAppId": "com.zoeedtech.app"
  },
  "buildVersion": "7",
  "mac": {
    "category": "public.app-category.education",
    "icon": "assets/zoe.icns",
    "minimumSystemVersion": "12.0"
  },
  "afterPack": "./verify-mas-package.js"
}
