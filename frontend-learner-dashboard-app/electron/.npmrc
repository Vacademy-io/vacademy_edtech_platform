# electron-builder 23.6.0 cannot read pnpm's symlinked node_modules: it packs only
# the top-level entries and silently drops every transitive dependency, so the
# packaged app dies on its first require (e.g. "Cannot find module 'clean-stack'"
# from electron-unhandled). A hoisted, real-directory layout is what it expects.
node-linker=hoisted
