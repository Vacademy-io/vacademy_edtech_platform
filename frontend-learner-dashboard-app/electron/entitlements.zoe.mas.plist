<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Mandatory for the Mac App Store. Also what confines the OTA web bundle to
       the app's own container (see electron/src/ota.ts) — no extra entitlement is
       needed to write there, and nothing outside it is reachable. -->
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <!-- The app is a web client: it talks to backend-stage.vacademy.io and S3/CloudFront. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- Learners save/open course material and offline downloads. -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <key>com.apple.security.files.downloads.read-write</key>
  <true/>
  <!-- Microphone ONLY, for the AI assistant's voice input (useVoiceRecorder ->
       getUserMedia({audio}) in src/hooks/useVoiceRecorder.ts, reached from the
       chatbot mic button). There is deliberately NO com.apple.security.device.camera:
       nothing in this app opens a video stream — the webcam-proctoring hook
       (src/hooks/proctoring/useCamDetection.ts) is commented out, and live classes
       (BBB/Zoom) are handed to the default browser by setup.ts's
       setWindowOpenHandler, so they never capture inside the app. Apple rejected
       build 4 under Guideline 2.4.5(i) for exactly that unused camera key
       (2026-08-26); do not add it back without shipping in-app video first. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Bundle id io.zoeedtech.app on team 7XKD5M7288 (Saurabh Kumar). This is the
       SAME bundle id as the ZOE Online School iOS app, so the Mac build joins the
       EXISTING app record (id 6794024192) as its macOS platform. A different id
       would create a separate listing instead. -->
  <key>com.apple.application-identifier</key>
  <string>7XKD5M7288.io.zoeedtech.app</string>
  <key>com.apple.developer.team-identifier</key>
  <string>7XKD5M7288</string>
</dict>
</plist>
