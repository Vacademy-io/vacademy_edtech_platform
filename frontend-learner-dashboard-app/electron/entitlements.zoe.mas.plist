<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Mandatory for the Mac App Store. Also what confines the OTA web bundle to
       the app's own container (see electron/src/ota.ts) — no extra entitlement is
       needed to write there, and nothing outside it is reachable. -->
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <!-- The app is a web client: it talks to backend-stage.vacademy.io and S3/CloudFront. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- Learners save/open course material and offline downloads. -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <key>com.apple.security.files.downloads.read-write</key>
  <true/>
  <!-- Microphone: live classes (BBB inside the app, src/routes/study-library/live-class/
       classroom/) and the AI assistant's voice input (src/hooks/useVoiceRecorder.ts). -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Camera: live classes now run INSIDE the app (BBB in an iframe, getUserMedia({video})
       when the learner turns the camera on). History: Apple rejected build 4 under
       Guideline 2.4.5(i) (2026-08-26) for this key while nothing used the camera; it is
       back only because in-app video ships with it. Do not remove the in-app class and
       keep this key — that recreates the rejection. -->
  <key>com.apple.security.device.camera</key>
  <true/>
  <!-- WebRTC (live-class audio/video) binds local UDP sockets for ICE and receives media
       on them. network.client only covers outbound traffic; binding/inbound needs
       network.server under the App Sandbox. No listening service is exposed. -->
  <key>com.apple.security.network.server</key>
  <true/>
  <!-- Bundle id io.zoeedtech.app on team 7XKD5M7288 (Saurabh Kumar). This is the
       SAME bundle id as the ZOE Online School iOS app, so the Mac build joins the
       EXISTING app record (id 6794024192) as its macOS platform. A different id
       would create a separate listing instead. -->
  <key>com.apple.application-identifier</key>
  <string>7XKD5M7288.io.zoeedtech.app</string>
  <key>com.apple.developer.team-identifier</key>
  <string>7XKD5M7288</string>
</dict>
</plist>
