APP_ENV=stage

# Preferred: direct SQLAlchemy URL (psycopg)
# DATABASE_URL=postgresql+psycopg://username:password@host:5432/dbname

# OR provide discrete parts:
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vacademy
# Optional schema override (e.g., admin core uses non-public schema)
# DB_SCHEMA=admin_core

# If you only have JDBC URL from admin-core (Spring), set it here and keep DB_USERNAME/DB_PASSWORD above:
# ADMIN_CORE_SERVICE_DB_URL=jdbc:postgresql://localhost:5432/vacademy?currentSchema=admin_core

# Cors
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=2
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type



# --- MCP server (Model Context Protocol) ---
# ON by default — leave it unset. Exposing the endpoint grants nobody anything:
# each institute must still enable it from Settings -> MCP Server, and learners
# are refused unconditionally. Set to false only as an emergency kill switch.
# MCP_SERVER_ENABLED=true
# Public URL of the MCP endpoint. Doubles as the OAuth issuer and the RFC 8707
# resource identifier, so it must be the externally reachable URL, and HTTPS
# (localhost is exempt for local development).
MCP_ISSUER_URL=https://backend-stage.vacademy.io/ai-service/mcp
# Where MCP clients are sent to sign in and approve a connection.
ADMIN_DASHBOARD_URL=https://dash.vacademy.io
# Recommended (not required): encrypts the platform tokens stored against each
# grant. Falls back to INTERNAL_SERVICE_TOKEN, then JWT_SECRET_KEY, when unset.
# Set a dedicated key in production. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MCP_TOKEN_ENCRYPTION_KEY=
# Optional TTLs (seconds). Defaults: 1h access, 30d refresh, 15m pending
# authorization, 5m authorization code.
# MCP_ACCESS_TOKEN_TTL_SECONDS=3600
# MCP_REFRESH_TOKEN_TTL_SECONDS=2592000
# MCP_AUTH_TXN_TTL_SECONDS=900
# MCP_AUTH_CODE_TTL_SECONDS=300
