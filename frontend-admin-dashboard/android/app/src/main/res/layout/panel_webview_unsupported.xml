<?xml version="1.0" encoding="utf-8"?>
<!-- Vacademy Classroom: shown by MainActivity.load() instead of the Capacitor bridge
     when the system WebView is older than R.integer.panel_min_webview_major.
     Sized for a 10-foot landscape touch screen; buttons are D-pad focusable. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/panel_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="48dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/panel_unsupported_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/panel_unsupported_title"
                android:textColor="@color/panel_text"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/panel_unsupported_requirement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/panel_text"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/panel_unsupported_detected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/panel_text_muted"
                android:textIsSelectable="true"
                android:textSize="20sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/panel_unsupported_steps_title"
                android:textColor="@color/panel_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/panel_unsupported_step_1"
                android:textColor="@color/panel_text"
                android:textSize="22sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/panel_unsupported_step_2"
                android:textColor="@color/panel_text"
                android:textSize="22sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/panel_unsupported_step_3"
                android:textColor="@color/panel_text"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/panel_btn_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="72dp"
                    android:minWidth="200dp"
                    android:backgroundTint="@color/panel_brand"
                    android:text="@string/panel_action_retry"
                    android:textAllCaps="false"
                    android:textColor="@color/panel_surface"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/panel_btn_home"
                    android:layout_width="wrap_content"
                    android:layout_height="72dp"
                    android:layout_marginStart="16dp"
                    android:minWidth="200dp"
                    android:text="@string/panel_action_choose_home"
                    android:textAllCaps="false"
                    android:textColor="@color/panel_text"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/panel_btn_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="72dp"
                    android:layout_marginStart="16dp"
                    android:minWidth="200dp"
                    android:text="@string/panel_action_settings"
                    android:textAllCaps="false"
                    android:textColor="@color/panel_text"
                    android:textSize="22sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
