{
    "name": "admin",
    "version": "1.0.4",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=20.0.0"
    },
    "sideEffects": [
        "*.css",
        "*.scss",
        "*.sass",
        "**/init.*"
    ],
    "scripts": {
        "dev": "vite",
        "build": "pnpm run build:tsc && pnpm run build:vite",
        "build:tsc": "node node_modules/typescript-native/lib/tsc.js -p tsconfig.json",
        "build:tsc:legacy": "cross-env NODE_OPTIONS=--max-old-space-size=6144 node node_modules/typescript/bin/tsc -p tsconfig.json",
        "build:vite": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build",
        "serve": "vite preview",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "lint": "eslint src --max-warnings=0",
        "lint:naming": "node scripts/lint-naming-terms.cjs",
        "typecheck": "node node_modules/typescript-native/lib/tsc.js -p tsconfig.json",
        "gen:routes": "node scripts/generate-routes.mjs",
        "precommit": "pnpm run typecheck && pnpm run lint && pnpm run build",
        "prepare": "cd .. && husky .husky || true",
        "lint-staged": "lint-staged",
        "storybook": "concurrently 'pnpm:watch*'",
        "watch:tailwind": "tailwindcss -i ./src/index.css -o ./src/styles/tailwind.css --watch",
        "watch:storybook": "storybook dev -p 6006",
        "build:tailwind": "tailwindcss -i ./src/index.css -o ./src/styles/tailwind.css",
        "build-storybook": "pnpm build:tailwind && storybook build",
        "cap:sync": "pnpm run build && cap sync",
        "cap:sync:fast": "cap sync",
        "cap:open:ios": "cap open ios",
        "cap:open:android": "cap open android",
        "cap:run:ios": "pnpm run build && cap sync ios && cap run ios",
        "cap:run:android": "pnpm run build && cap sync android && cap run android",
        "cap:add:ios": "cap add ios",
        "cap:add:android": "cap add android",
        "build:vacademy-admin": "cross-env VITE_CAP_FLAVOR=vacademy-admin pnpm run build",
        "build:vimotion": "cross-env VITE_CAP_FLAVOR=vimotion pnpm run build",
        "cap:add:vacademy-admin:ios": "cross-env VITE_CAP_FLAVOR=vacademy-admin cap add ios",
        "cap:add:vacademy-admin:android": "cross-env VITE_CAP_FLAVOR=vacademy-admin cap add android",
        "cap:sync:vacademy-admin": "pnpm run build:vacademy-admin && cross-env VITE_CAP_FLAVOR=vacademy-admin cap sync",
        "cap:sync:vacademy-admin:fast": "cross-env VITE_CAP_FLAVOR=vacademy-admin cap sync",
        "cap:run:vacademy-admin:ios": "pnpm run build:vacademy-admin && cross-env VITE_CAP_FLAVOR=vacademy-admin cap sync ios && cross-env VITE_CAP_FLAVOR=vacademy-admin cap run ios",
        "cap:run:vacademy-admin:android": "pnpm run build:vacademy-admin && cross-env VITE_CAP_FLAVOR=vacademy-admin cap sync android && cross-env VITE_CAP_FLAVOR=vacademy-admin cap run android --flavor=vacademyAdmin",
        "cap:open:vacademy-admin:ios": "cross-env VITE_CAP_FLAVOR=vacademy-admin cap open ios",
        "cap:open:vacademy-admin:android": "cross-env VITE_CAP_FLAVOR=vacademy-admin cap open android",
        "android:assemble:vacademy-admin:debug": "cd android && ./gradlew assembleVacademyAdminDebug",
        "android:assemble:vacademy-admin:release": "cd android && ./gradlew assembleVacademyAdminRelease",
        "android:bundle:vacademy-admin:release": "cd android && ./gradlew bundleVacademyAdminRelease",
        "ota:publish:vacademy-admin": "cross-env VITE_CAP_FLAVOR=vacademy-admin bash scripts/publish-ota.sh"
    },
