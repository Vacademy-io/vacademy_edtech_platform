# Copy to /opt/voice-bot/.env on the Mumbai box and fill the blanks.
# Values mirror the k8s deployment in Singapore — same identity, same vendors.

# Public base of THIS box (must match the Caddyfile hostname + DNS record).
PUBLIC_BASE=https://voice-bot-in.vacademy.io/voice-bot-service

# Control plane stays in Singapore — 3 small HTTP calls per call, not latency-critical.
ADMIN_CORE_BASE=https://backend-stage.vacademy.io

# Internal identity: must match a row in admin_core's client_secret_key table.
# (Prod currently reuses the admin_core_service row — same values as the k8s env.)
VOICE_BOT_CLIENT_NAME=admin_core_service
VOICE_BOT_CLIENT_SECRET=

# Sarvam STT (saaras) + TTS (bulbul)
SARVAM_API_KEY=

# Conversation + analysis LLM — Gemini hit directly (Mumbai edge).
LLM_PROVIDER=google
GEMINI_API_KEY=

# Voice tuning (same as prod)
TTS_PACE=1.1
# VAD_STOP_SECS=0.5
# AGG_TIMEOUT_SECS=0.2

# ── TTS speech cache ────────────────────────────────────────────────────────
# Replays audio already paid for when the SAME sentence is spoken again in the
# same voice. Matching is an exact sha256 — one differing character goes to the
# vendor. See docs/crm/TTS_SPEECH_CACHE.md.
#
# THE ON SWITCH IS NOT HERE. It is ai_agent.speech_cache_mode (OFF|FIXED|FULL),
# set per agent via the agent API or SQL. Every agent defaults to OFF, so
# this feature is inert until somebody deliberately enables one.
#
# The two below are KILL switches: they default true and exist so ops can stop
# the feature fleet-wide in one restart without touching any institute's config.
# Setting them true enables nothing on its own.
# TTS_CACHE_SPEECH_ENABLED=true
# TTS_CACHE_LLM_ENABLED=true

# Optional EXTRA ops restriction on top of the per-agent mode — pin the cache to
# named agents (id or name) regardless of what the DB says. Normally empty.
# TTS_CACHE_AGENTS=

# Bump to invalidate EVERY entry at once — the escape hatch if a bad blob ever
# lands, since a bad entry is otherwise served to every future match, forever.
# TTS_CACHE_SALT=v1

# Qualifying sightings before one off-call render is spent on a sentence.
# "Qualifying" is strict: complete, uninterrupted, confirmed played to the
# caller, on a call whose health verdict was not RED. Break-even is 3 uses.
# TTS_CACHE_MIN_SEEN=1

# Its own budget — the existing sweep only evicts *.mp3, so this namespace would
# otherwise grow until the volume is full. 8 kHz s16 = 16 KB/s, so 2 GB is about
# 32k sentences. df the box before raising it.
# TTS_SPEECH_CACHE_MAX_BYTES=2147483648

# CI rewrites this line on every deploy with the immutable :<git-sha> tag.
VOICE_BOT_IMAGE=public.ecr.aws/e0x1f4p4/voice-bot-service/voice-bot-service-repo:latest
